<h1>R@1D</h1>
<div id="projects">
    <table>
        <thead>
            <th>Name</th>
            <th>Owner</th>
            <th>Bugs</th>
        </thead>
        <tbody>
            <% @projects.each do |project| %>
            <tr>
                <td><%= project.name %></td>
                <td><%= project.owner.name %></td>
                <td><%= project.bugs.count %></td>
            </tr>
            <% end %>
        </tbody>
    </table>
</div>
<%= button_to "Log out", destroy_user_session_path, method: :delete %>