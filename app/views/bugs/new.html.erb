<h1>New Bug</h1>
<%= form_with model: @bug do |form| %>
    <% @bug.errors.full_messages.each do |message| %>
    <div><%= message %></div>
    <% end %>
    <div>
        <%= form.label :title %>
        <%= form.text_field :title %>
    </div>
    <div>
        <%= form.label :description %>
        <%= form.text_field :description %>
    </div>
    <div>
        <%= form.label :replication %>
        <%= form.text_field :replication %>
    </div>
    <div>
        <%= form.label :priority %>
        <%= form.select :priority, Bug::PRIORITY %>
    </div>
    <div>
        <%= form.label :status %>
        <%= form.select :status, Bug::STATUS %>
    </div>
    <%= form.submit "Create Bug" %>
<% end %>
<%= link_to "Back", @bug.project %>

