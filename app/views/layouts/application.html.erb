<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ra1d" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ra1d">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <!-- =========================
         START NAVBAR WITH USER ICON 
         Place ABOVE yield so it appears on all pages 
         ========================= -->
    <nav>
      <% if user_signed_in? %>
        <details>
          <summary>
            <span>👤</span>
          </summary>
          <div class="profile_button">
            <div class="edit_profile">
              <%= link_to "Edit Profile", edit_user_registration_path %>
            </div>
            <div class="sign_out">
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "sign_out_btn" %>
            </div>
          </div>
        </details>
      <% end %>
    </nav>
    <!-- =========================
         END NAVBAR 
         ========================= -->
    <%= yield %>
  </body>
</html>

<style>
  nav {
    height: 60px; 
    display: flex; 
    align-items: center; 
    justify-content: flex-end; 
    background: #f8f9fa;
    padding: 0 24px; 
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }

  details {
    position: relative; 
    display: inline-block;
  }

  summary {
    list-style: none; 
    cursor: pointer; 
    border: none; 
    background: none; 
    padding: 0;
  }

  span {
    font-size:1.8em; 
    vertical-align: middle;
  }

  div.profile_button {
    position: absolute; 
    right: 0; 
    min-width: 160px; 
    z-index: 100;
    font-size: 14px;
    background: white; 
    border: 1px solid #ccc; 
    border-radius: 4px; 
  }

  div.edit_profile a {
    display: block; 
    width: 80px;
    justify-self: center;
    text-align: center;
    margin: 5px;
    border: 1px solid rgb(100, 100, 100);
    border-radius: 2px;
    padding: 2px 0; 
    text-decoration: none; 
    color: #333;
    background-color: rgb(245, 245, 245);
  }

  div.edit_profile a:hover {
    background-color: rgb(225, 225, 225);
  }

  div.sign_out {
    width: 100%;
    text-align: center; 
    margin-bottom: 5px;
    color: #333;  
  }

  button.sign_out_btn {
    width: 80px;
  }

  button.sign_out_btn:hover {
    cursor: pointer;
  }
</style>